rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true)
        || (
          'phone_number' in request.auth.token
          && request.auth.token.phone_number is string
          && request.auth.token.phone_number.size() >= 6
          && 'firebase' in request.auth.token
          && request.auth.token.firebase.sign_in_provider == 'phone'
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'mdsiyam32112@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin();
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 1 && slug.size() <= 80 && slug.matches('^[a-z0-9\\-]+$');
    }

    function isValidTrackingCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 32 && code.matches('^SHL-[A-Z0-9]+$');
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'slug', 'description', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && isValidSlug(data.slug)
        && data.description is string && data.description.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'description', 'categoryId', 'categoryName',
          'price', 'stock', 'sku', 'imageUrl', 'featured', 'expressEligible',
          'ratingAvg', 'reviewCount', 'soldCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'description', 'categoryId', 'categoryName',
          'price', 'compareAtPrice', 'stock', 'sku', 'imageUrl', 'featured',
          'expressEligible', 'ratingAvg', 'reviewCount', 'soldCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 2000
        && isValidId(data.categoryId)
        && data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 80
        && data.price is number && data.price >= 0 && data.price <= 10000000
        && (!('compareAtPrice' in data) || (data.compareAtPrice is number && data.compareAtPrice >= 0 && data.compareAtPrice <= 10000000))
        && data.stock is number && data.stock >= 0 && data.stock <= 1000000
        && data.sku is string && data.sku.size() >= 1 && data.sku.size() <= 64
        && data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 1000
        && data.featured is bool
        && data.expressEligible is bool
        && data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5
        && data.reviewCount is number && data.reviewCount >= 0
        && data.soldCount is number && data.soldCount >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'id', 'productId', 'userId', 'authorName', 'rating',
          'comment', 'verifiedPurchase', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'productId', 'userId', 'authorName', 'rating',
          'comment', 'verifiedPurchase', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.productId)
        && isValidId(data.userId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1000
        && data.verifiedPurchase is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role in ['customer', 'admin']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll([
          'userId', 'email', 'phone', 'address', 'city', 'postalCode', 'preferredDelivery', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'email', 'phone', 'address', 'city', 'postalCode', 'preferredDelivery', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.email is string && data.email.size() <= 160
        && data.phone is string && data.phone.size() <= 30
        && data.address is string && data.address.size() <= 400
        && data.city is string && data.city.size() <= 80
        && data.postalCode is string && data.postalCode.size() <= 20
        && data.preferredDelivery in ['express', 'standard']
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'trackingCode', 'userId', 'customerName', 'customerPhone',
          'shippingAddress', 'city', 'postalCode', 'items', 'subtotal',
          'deliveryFee', 'totalAmount', 'deliverySpeed', 'paymentMethod',
          'paymentStatus', 'paymentReference', 'status', 'courierNote',
          'source', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'trackingCode', 'userId', 'customerName', 'customerPhone',
          'shippingAddress', 'city', 'postalCode', 'items', 'subtotal',
          'deliveryFee', 'totalAmount', 'deliverySpeed', 'paymentMethod',
          'paymentStatus', 'paymentReference', 'status', 'courierNote',
          'source', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidTrackingCode(data.trackingCode)
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 100
        && data.customerPhone is string && data.customerPhone.size() >= 6 && data.customerPhone.size() <= 30
        && data.shippingAddress is string && data.shippingAddress.size() >= 3 && data.shippingAddress.size() <= 400
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && data.postalCode is string && data.postalCode.size() <= 20
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 25 && data.items[0] is map
        && data.subtotal is number && data.subtotal >= 0
        && data.deliveryFee is number && data.deliveryFee >= 0
        && data.totalAmount is number && data.totalAmount >= 0
        && data.deliverySpeed in ['express', 'standard']
        && data.paymentMethod in ['bkash', 'nagad', 'card', 'cod']
        && data.paymentStatus in ['paid', 'pending_cod', 'refunded']
        && data.paymentReference is string && data.paymentReference.size() <= 80
        && data.status in ['pending', 'confirmed', 'packed', 'shipped', 'delivered', 'cancelled']
        && data.courierNote is string && data.courierNote.size() <= 300
        && data.source in ['web', 'fb_shop_now']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll([
          'trackingCode', 'orderId', 'userId', 'status', 'deliverySpeed',
          'city', 'itemCount', 'courierNote', 'estimatedWindow', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'trackingCode', 'orderId', 'userId', 'status', 'deliverySpeed',
          'city', 'itemCount', 'courierNote', 'estimatedWindow', 'createdAt', 'updatedAt'
        ])
        && isValidTrackingCode(data.trackingCode)
        && isValidId(data.orderId)
        && isValidId(data.userId)
        && data.status in ['pending', 'confirmed', 'packed', 'shipped', 'delivered', 'cancelled']
        && data.deliverySpeed in ['express', 'standard']
        && data.city is string && data.city.size() >= 1 && data.city.size() <= 80
        && data.itemCount is number && data.itemCount >= 1 && data.itemCount <= 100
        && data.courierNote is string && data.courierNote.size() <= 300
        && data.estimatedWindow is string && data.estimatedWindow.size() >= 1 && data.estimatedWindow.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
          'id', 'recipientId', 'title', 'message', 'type', 'relatedOrderId', 'read', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'recipientId', 'title', 'message', 'type', 'relatedOrderId', 'read', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.recipientId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && data.type in ['order_placed', 'order_status', 'stock_alert', 'promo']
        && data.relatedOrderId is string && data.relatedOrderId.size() <= 128
        && data.read is bool
        && data.createdAt is timestamp;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
          'id', 'storeName', 'tagline', 'facebookUrl', 'messengerUrl',
          'whatsappNumber', 'instagramUrl', 'freeDeliveryThreshold',
          'standardDeliveryFee', 'expressDeliveryFee', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'storeName', 'tagline', 'facebookUrl', 'messengerUrl',
          'whatsappNumber', 'instagramUrl', 'freeDeliveryThreshold',
          'standardDeliveryFee', 'expressDeliveryFee', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 100
        && data.tagline is string && data.tagline.size() <= 200
        && data.facebookUrl is string && data.facebookUrl.size() <= 300
        && data.messengerUrl is string && data.messengerUrl.size() <= 300
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 30
        && data.instagramUrl is string && data.instagramUrl.size() <= 300
        && data.freeDeliveryThreshold is number && data.freeDeliveryThreshold >= 0
        && data.standardDeliveryFee is number && data.standardDeliveryFee >= 0
        && data.expressDeliveryFee is number && data.expressDeliveryFee >= 0
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId)
        && isAdmin()
        && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId)
        && isAdmin()
        && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'updatedAt']);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId)
        && isAdmin()
        && isValidProduct(incoming())
        && incoming().id == productId
        && (exists(/databases/$(database)/documents/categories/$(incoming().categoryId))
            || existsAfter(/databases/$(database)/documents/categories/$(incoming().categoryId)))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'description', 'categoryId', 'categoryName', 'price', 'compareAtPrice',
            'stock', 'sku', 'imageUrl', 'featured', 'expressEligible', 'ratingAvg', 'reviewCount', 'soldCount', 'updatedAt'
          ]))
          ||
          (isVerifiedUser()
            && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'soldCount', 'updatedAt'])
            && incoming().stock >= 0
            && incoming().stock < existing().stock
            && incoming().soldCount == existing().soldCount + (existing().stock - incoming().stock))
        );
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isValidId(reviewId)
        && isVerifiedUser()
        && isValidReview(incoming())
        && incoming().id == reviewId
        && incoming().userId == request.auth.uid
        && (exists(/databases/$(database)/documents/products/$(incoming().productId))
            || existsAfter(/databases/$(database)/documents/products/$(incoming().productId)))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(reviewId)
        && isVerifiedUser()
        && isValidReview(incoming())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().productId == existing().productId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (existing().userId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'authorName', 'updatedAt']))
        );
      allow delete: if isValidId(reviewId) && (isAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(userId)
        && isVerifiedUser()
        && isOwner(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == userId
        && (incoming().role == 'customer' || isBootstrappedAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (isOwner(userId)
              && incoming().role == existing().role
              && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();

      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(userId) && isValidId(docId)
          && isVerifiedUser()
          && (isOwner(userId) || isAdmin())
          && isValidUserPrivate(incoming())
          && incoming().userId == userId
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId)
          && isVerifiedUser()
          && (isOwner(userId) || isAdmin())
          && isValidUserPrivate(incoming())
          && incoming().userId == existing().userId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'phone', 'address', 'city', 'postalCode', 'preferredDelivery', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      }
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(orderId)
        && isVerifiedUser()
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && (incoming().paymentMethod == 'cod' ? incoming().paymentStatus == 'pending_cod' : incoming().paymentStatus == 'paid')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orderTracking/$(incoming().trackingCode))
        && getAfter(/databases/$(database)/documents/orderTracking/$(incoming().trackingCode)).data.orderId == orderId;
      allow update: if isValidId(orderId)
        && isVerifiedUser()
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().trackingCode == existing().trackingCode
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (existing().userId == request.auth.uid
              && !(existing().status in ['delivered', 'cancelled'])
              && existing().status == 'pending'
              && incoming().status == 'cancelled'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /orderTracking/{trackingCode} {
      allow get: if isValidId(trackingCode);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(trackingCode)
        && isVerifiedUser()
        && isValidOrderTracking(incoming())
        && incoming().trackingCode == trackingCode
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderId));
      allow update: if isValidId(trackingCode)
        && isVerifiedUser()
        && isValidOrderTracking(incoming())
        && incoming().trackingCode == existing().trackingCode
        && incoming().orderId == existing().orderId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (existing().userId == request.auth.uid
              && existing().status == 'pending'
              && incoming().status == 'cancelled'
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
      allow delete: if isValidId(trackingCode) && isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().recipientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.recipientId == request.auth.uid || (resource.data.recipientId == 'admin' && isBootstrappedAdmin()));
      allow create: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming())
        && incoming().id == notificationId
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (incoming().recipientId == request.auth.uid && incoming().read == false)
          || (incoming().recipientId == 'admin' && incoming().type == 'order_placed' && incoming().read == false
              && existsAfter(/databases/$(database)/documents/orders/$(incoming().relatedOrderId)))
        );
      allow update: if isValidId(notificationId)
        && isVerifiedUser()
        && isValidNotification(incoming())
        && incoming().id == existing().id
        && incoming().recipientId == existing().recipientId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        && (isAdmin() || existing().recipientId == request.auth.uid);
      allow delete: if isValidId(notificationId) && (isAdmin() || (isVerifiedUser() && existing().recipientId == request.auth.uid));
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if isValidId(settingId)
        && isAdmin()
        && isValidStoreSettings(incoming())
        && incoming().id == settingId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(settingId) && isAdmin();
    }

    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && isSignedIn() && (isOwner(adminUid) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update: if isValidId(adminUid)
        && isBootstrappedAdmin()
        && isValidAdminRecord(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time;
      allow delete: if isValidId(adminUid) && isBootstrappedAdmin();
    }
  }
}
