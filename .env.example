# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MULTI-FIREBASE CONFIGURATION (Public Web Client SDK Config ONLY)
# ==============================================================================
# SECURITY NOTICE:
# - Only store Firebase PUBLIC Web Client configuration values in VITE_* vars.
# - NEVER place Firebase Admin SDK Service Account JSON, private_key,
#   client_email, or private secrets into any VITE_* frontend env variable.
# - You can connect 3, 4, 5, or unlimited Firebase projects by incrementing
#   the numeric index: VITE_FIREBASE_PROJECT_5_*, VITE_FIREBASE_PROJECT_6_*, etc.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE ROLE MAPPING (Optional - defaults are smartly assigned if configured)
# Valid project keys: project_1, project_2, project_3, project_4, project_5, ...
# ------------------------------------------------------------------------------
VITE_FIREBASE_ROLE_USERS="project_1"
VITE_FIREBASE_ROLE_CATALOG="project_1"
VITE_FIREBASE_ROLE_TRANSACTIONS="project_2"
VITE_FIREBASE_ROLE_ENGAGEMENT="project_3"
VITE_FIREBASE_ROLE_ADMIN="project_4"

# ------------------------------------------------------------------------------
# FIREBASE PROJECT 1: Primary Auth, User Profiles & Catalog
# (When omitted, Project 1 falls back to firebase-applet-config.json)
# ------------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_1_LABEL="Firebase 1 (Users & Profiles)"
VITE_FIREBASE_PROJECT_1_API_KEY="YOUR_FIREBASE_1_PUBLIC_WEB_API_KEY"
VITE_FIREBASE_PROJECT_1_AUTH_DOMAIN="your-project-1.firebaseapp.com"
VITE_FIREBASE_PROJECT_1_PROJECT_ID="your-project-1-id"
VITE_FIREBASE_PROJECT_1_STORAGE_BUCKET="your-project-1.firebasestorage.app"
VITE_FIREBASE_PROJECT_1_MESSAGING_SENDER_ID="100000000001"
VITE_FIREBASE_PROJECT_1_APP_ID="1:100000000001:web:placeholder1"
VITE_FIREBASE_PROJECT_1_DATABASE_ID="(default)"
VITE_FIREBASE_PROJECT_1_ENABLED="true"

# ------------------------------------------------------------------------------
# FIREBASE PROJECT 2: Transactions, Orders, Deposits, Withdrawals & Payments
# ------------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_2_LABEL="Firebase 2 (Transactions & Payments)"
VITE_FIREBASE_PROJECT_2_API_KEY="YOUR_FIREBASE_2_PUBLIC_WEB_API_KEY"
VITE_FIREBASE_PROJECT_2_AUTH_DOMAIN="your-project-2.firebaseapp.com"
VITE_FIREBASE_PROJECT_2_PROJECT_ID="your-project-2-id"
VITE_FIREBASE_PROJECT_2_STORAGE_BUCKET="your-project-2.firebasestorage.app"
VITE_FIREBASE_PROJECT_2_MESSAGING_SENDER_ID="200000000002"
VITE_FIREBASE_PROJECT_2_APP_ID="1:200000000002:web:placeholder2"
VITE_FIREBASE_PROJECT_2_DATABASE_ID="(default)"
VITE_FIREBASE_PROJECT_2_ENABLED="true"

# ------------------------------------------------------------------------------
# FIREBASE PROJECT 3: Ads, Tasks, Rewards, Reviews & Earning Records
# ------------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_3_LABEL="Firebase 3 (Ads, Tasks & Rewards)"
VITE_FIREBASE_PROJECT_3_API_KEY="YOUR_FIREBASE_3_PUBLIC_WEB_API_KEY"
VITE_FIREBASE_PROJECT_3_AUTH_DOMAIN="your-project-3.firebaseapp.com"
VITE_FIREBASE_PROJECT_3_PROJECT_ID="your-project-3-id"
VITE_FIREBASE_PROJECT_3_STORAGE_BUCKET="your-project-3.firebasestorage.app"
VITE_FIREBASE_PROJECT_3_MESSAGING_SENDER_ID="300000000003"
VITE_FIREBASE_PROJECT_3_APP_ID="1:300000000003:web:placeholder3"
VITE_FIREBASE_PROJECT_3_DATABASE_ID="(default)"
VITE_FIREBASE_PROJECT_3_ENABLED="true"

# ------------------------------------------------------------------------------
# FIREBASE PROJECT 4: Admin Settings, Reports & Application Configuration
# ------------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_4_LABEL="Firebase 4 (Admin Settings & Reports)"
VITE_FIREBASE_PROJECT_4_API_KEY="YOUR_FIREBASE_4_PUBLIC_WEB_API_KEY"
VITE_FIREBASE_PROJECT_4_AUTH_DOMAIN="your-project-4.firebaseapp.com"
VITE_FIREBASE_PROJECT_4_PROJECT_ID="your-project-4-id"
VITE_FIREBASE_PROJECT_4_STORAGE_BUCKET="your-project-4.firebasestorage.app"
VITE_FIREBASE_PROJECT_4_MESSAGING_SENDER_ID="400000000004"
VITE_FIREBASE_PROJECT_4_APP_ID="1:400000000004:web:placeholder4"
VITE_FIREBASE_PROJECT_4_DATABASE_ID="(default)"
VITE_FIREBASE_PROJECT_4_ENABLED="true"

# ------------------------------------------------------------------------------
# NEED PROJECT 5, 6, OR MORE? Simply copy a block above and change _4_ to _5_:
# VITE_FIREBASE_PROJECT_5_LABEL="Firebase 5 (Analytics / Archive)"
# VITE_FIREBASE_PROJECT_5_API_KEY="YOUR_FIREBASE_5_PUBLIC_WEB_API_KEY"
# VITE_FIREBASE_PROJECT_5_AUTH_DOMAIN="your-project-5.firebaseapp.com"
# VITE_FIREBASE_PROJECT_5_PROJECT_ID="your-project-5-id"
# VITE_FIREBASE_PROJECT_5_STORAGE_BUCKET="your-project-5.firebasestorage.app"
# VITE_FIREBASE_PROJECT_5_MESSAGING_SENDER_ID="500000000005"
# VITE_FIREBASE_PROJECT_5_APP_ID="1:500000000005:web:placeholder5"
# VITE_FIREBASE_PROJECT_5_DATABASE_ID="(default)"
# VITE_FIREBASE_PROJECT_5_ENABLED="true"
# ------------------------------------------------------------------------------

